# ─────────────────────────────────────────────────────────────────────────────
# CodeEarly 2.0 — environment
# Copy to .env and fill in. docker-compose reads this file.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost                     # public base URL (https://www.codeearly.com in prod)
PORT=3000

# Postgres (compose service name = "postgres")
POSTGRES_USER=codeearly
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=codeearly
# App connection string (used by Prisma). Host is the compose service name.
DATABASE_URL=postgresql://codeearly:change-me-strong@postgres:5432/codeearly?schema=public

# Redis (compose service name = "redis")
REDIS_URL=redis://redis:6379

# Auth (Better Auth) — generate a 32+ char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# Email
RESEND_API_KEY=
SMTP_FROM=CodeEarly <hello@codeearly.com>
# SMTP fallback (Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Storage (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=codeearly
R2_PUBLIC_URL=

# Reverse proxy (Caddy) — domain it serves in production
SITE_DOMAIN=localhost
