{
  "name": "codeearly-2.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "worker": "tsx src/jobs/worker.ts",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "auth:generate": "npx @better-auth/cli generate --output prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//overrides": "next@16 still bundles postcss 8.4.31 and sharp 0.34.5, both carrying high-severity advisories (libvips CVEs in sharp; XSS + arbitrary file read in postcss). Forcing the patched versions here rather than waiting for Next to bump them. Revisit when a Next release ships them itself. Never run `npm audit fix --force` on this repo: it proposes next@9.3.3, a six-major downgrade.",
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.0"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "better-auth": "^1.1.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "next": "^16.2.12",
    "pino": "^9.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
