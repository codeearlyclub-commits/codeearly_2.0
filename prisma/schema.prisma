// CodeEarly 2.0 — Prisma schema
// Single source of truth for the data model. Real foreign keys + cascade
// deletes replace V4's 14-collection manual cleanup. Money is stored in integer
// kobo. Statuses are enums the database enforces (no more "null"-string bugs).
//
// Regenerate the client after edits:   npx prisma generate
// Create/apply a migration:            npx prisma migrate dev --name <change>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH (Better Auth core models). `User` is the PARENT account (the auth entity);
// parent-specific profile fields live here via Better Auth additionalFields.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  // Managed by Better Auth's admin() plugin: "user" (a parent) | "admin"
  // (CodeEarly staff). The plugin writes these columns itself, so they must
  // exist here or every sign-up fails at the insert.
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  // Parent profile (additionalFields)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  children       Child[]
  invoices       Invoice[]
  subscriptions  Subscription[]
  ownedOrgs      Organization[] @relation("OrgOwner")
  orgMemberships OrgMember[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  /// Set by the admin() plugin when staff impersonate a parent for support.
  /// Recorded so support access is auditable rather than invisible.
  impersonatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOMAIN CORE
// ─────────────────────────────────────────────────────────────────────────────

/// A child is a profile the parent manages, NOT a full user account — we hold
/// no email and no password for a minor. Children may optionally be given a
/// restricted sign-in of their own: a parent-issued code plus a PIN, revocable
/// at any time, granting lessons/tasks/quizzes only (never billing, settings,
/// siblings' data, or the parent's details).
model Child {
  id            String   @id @default(cuid())
  parentId      String
  parent        User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  membershipId  String   @unique // CE-YYYY-XXXX (random, non-sequential suffix)
  childName     String
  dateOfBirth   DateTime?
  gender        String?
  createdAt     DateTime @default(now())

  // ── Student sign-in (optional, parent-controlled) ─────────────────────────
  /// Short readable code the child types. Distinct from membershipId, which is
  /// printed on certificates — a code on public paper must never be a credential.
  loginCode         String?   @unique
  /// scrypt hash. A 4-digit PIN has only 10k values, so the real defence is
  /// lockout + rate limiting, not the hash — but we never store the PIN itself.
  pinHash           String?
  loginEnabled      Boolean   @default(false)
  pinUpdatedAt      DateTime?
  /// Lockout state. Reset on success; parent can clear it by reissuing the PIN.
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?

  enrollments        Enrollment[]
  programEnrollments ProgramEnrollment[]
  quizParticipants   QuizParticipant[]
  invoices           Invoice[]
  subscriptions      Subscription[]
  lessonProgress     LessonProgress[]
  courseCompletions  CourseCompletion[]
  activity           LearningActivity[]
  reportCards        ReportCard[]
  certificates       Certificate[]

  @@index([parentId])
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  description         String?
  level               String?
  ageRange            String?
  status              PublishStatus @default(DRAFT)
  requiresSubscription Boolean      @default(false)
  programOnly         Boolean       @default(false) // hidden from catalogs; program members only
  priceKobo           Int           @default(0)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  enrollments   Enrollment[]
  programLinks  ProgramCourse[]
  sections      CourseSection[]
  lessons       Lesson[]
  completions   CourseCompletion[]
}

// ─────────────────────────────────────────────────────────────────────────────
// LMS — what is actually INSIDE a course.
//
// Shaped to match V4, which imported from Moodle: course → section → lesson →
// content. That keeps the eventual migration a mapping rather than a redesign.
//
// One deliberate departure: content is STRUCTURED BLOCKS, not raw HTML. V4
// stored Moodle's HTML and sanitised it on the way out. Blocks remove the entire
// XSS surface by construction — there is no markup to escape — and they force
// consistent styling for children instead of whatever a copy-paste brought with
// it. Migrating V4's HTML will need a converter; that is a fair price for not
// serving unsanitised markup to a nine-year-old.
// ─────────────────────────────────────────────────────────────────────────────

/// A chapter within a course. Optional: a short course can hold lessons directly.
model CourseSection {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  summary  String?
  order    Int     @default(0)

  lessons Lesson[]

  @@index([courseId])
}

enum LessonKind {
  LESSON // taught content
  PAGE // reference material
  RESOURCE // a download or link
  QUIZ // links to a Competition
}

model Lesson {
  id        String        @id @default(cuid())
  /// Denormalised alongside sectionId so "all lessons in this course" is one
  /// query, and a lesson can exist without a section.
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?
  section   CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  title            String
  slug             String
  kind             LessonKind @default(LESSON)
  summary          String?
  order            Int        @default(0)
  estimatedMinutes Int?
  /// A LINK only. ARCHITECTURE §3: large video never lives in our storage —
  /// YouTube-unlisted or Cloudflare Stream, and we keep the URL.
  videoUrl         String?
  /// Drafts are invisible to children, exactly as unpublished courses are.
  published        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  blocks   LessonBlock[]
  progress LessonProgress[]

  @@unique([courseId, slug])
  @@index([sectionId])
  @@index([courseId, order])
}

enum BlockKind {
  HEADING
  TEXT
  CODE
  IMAGE
  VIDEO
  CALLOUT
  LIST
}

/// One piece of lesson content. `text` is always plain text — never markup.
model LessonBlock {
  id       String    @id @default(cuid())
  lessonId String
  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind     BlockKind @default(TEXT)
  /// Plain text for TEXT/HEADING/CODE/CALLOUT; a URL for IMAGE/VIDEO; one item
  /// per line for LIST.
  text     String
  /// Language for CODE, alt text for IMAGE, caption for VIDEO.
  meta     String?
  order    Int       @default(0)

  @@index([lessonId, order])
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

/// A child's progress through one lesson.
model LessonProgress {
  id        String         @id @default(cuid())
  childId   String
  child     Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status    ProgressStatus @default(IN_PROGRESS)
  /// Where they got to, so "continue" returns them to the right place rather
  /// than the top of the lesson.
  lastBlockOrder Int       @default(0)
  /// Accumulated engaged time. Reported to parents and on report cards, so it
  /// counts time the lesson was actually open and focused — not wall-clock time
  /// since a tab was left open overnight.
  timeSpentSeconds Int     @default(0)
  startedAt    DateTime    @default(now())
  lastAccessAt DateTime    @default(now())
  completedAt  DateTime?
  updatedAt    DateTime    @updatedAt

  @@unique([childId, lessonId])
  @@index([lessonId])
  @@index([childId, lastAccessAt])
}

/// A child finished every published lesson in a course.
///
/// Stored rather than derived: it is the fact a certificate attests to, and
/// publishing one more lesson later must not retroactively un-complete a course
/// a child already finished — or invalidate a certificate already in a frame.
model CourseCompletion {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  /// How many lessons the course had at the moment of completion, so the record
  /// stays truthful about what was actually finished.
  lessonCount Int

  @@unique([childId, courseId])
  @@index([courseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNER RECORDS — report cards and certificates.
//
// Both are documents a parent keeps, prints, and may show to a school. That
// makes them different from every other table here: once issued, what they say
// must not silently change because the underlying data moved on. So both store
// a SNAPSHOT of the figures at issue time rather than recomputing on render.
// ─────────────────────────────────────────────────────────────────────────────

enum ReportStatus {
  DRAFT // being written; invisible to the parent
  PUBLISHED // visible in the portal
}

model ReportCard {
  id       String @id @default(cuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Human label as it appears on the document, e.g. "Term 2, 2026".
  period   String
  periodStart DateTime
  periodEnd   DateTime

  /// Figures frozen at issue. A parent reading last term's report must see last
  /// term's numbers, not this term's — recomputing would quietly rewrite history.
  lessonsCompleted Int
  coursesCompleted Int
  minutesLearning  Int
  quizzesPlayed    Int
  averageQuizScore Int?

  /// Written by staff. The part parents actually read first.
  comment      String?
  /// Free-form, e.g. "Excellent", "Working hard". Deliberately not an enum:
  /// teachers phrase these differently and a fixed list would be fought.
  overallGrade String?

  status      ReportStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([childId, period])
  @@index([childId, status])
}

enum CertificateKind {
  COURSE
  PROGRAM
  COMPETITION
}

/// An award a child earned. Verifiable by anyone holding the serial.
model Certificate {
  id      String          @id @default(cuid())
  childId String
  child   Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind    CertificateKind

  /// Printed on the certificate and frozen: renaming a course later must not
  /// change what an already-issued certificate claims the child completed.
  title       String
  /// The child's name as printed, for the same reason.
  recipientName String
  /// Loose reference to the course/program/competition. No FK: deleting a course
  /// must not delete the evidence a child completed it.
  subjectId   String?

  /// Public verification code, e.g. CE-CERT-4K7QX9. Printed on the document so a
  /// school can check it is genuine without contacting us.
  serial String @unique

  issuedAt DateTime @default(now())
  /// Set if a certificate is withdrawn (issued in error, for instance). Never
  /// deleted — a revoked certificate must still verify, and say it was revoked.
  revokedAt     DateTime?
  revokedReason String?

  @@index([childId])
  @@index([subjectId])
}

enum ActivityKind {
  LESSON_STARTED
  LESSON_COMPLETED
  COURSE_COMPLETED
  QUIZ_PLAYED
  PROGRAM_ATTENDED
}

/// Append-only record of learning activity.
///
/// FIRST-PARTY ONLY. There is deliberately no third-party analytics anywhere
/// near children: Apple's Kids Category and Google Play's Families policy both
/// restrict it, and it is the wrong thing to do regardless. This table exists to
/// show a parent what their child did and to build report cards from — not to
/// profile anyone.
///
/// Never updated, only inserted, so the history cannot be quietly rewritten.
model LearningActivity {
  id        String       @id @default(cuid())
  childId   String
  child     Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind      ActivityKind
  courseId  String?
  lessonId  String?
  /// Human-readable label captured at the time, so the feed still reads correctly
  /// after a lesson is renamed or removed.
  label     String
  createdAt DateTime     @default(now())

  @@index([childId, createdAt])
  @@index([courseId])
}

model Enrollment {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([childId, courseId])
  @@index([courseId])
}

model Program {
  id                   String        @id @default(cuid())
  title                String
  type                 String        @default("Summer")
  description          String?
  ageRange             String?
  location             String?
  status               PublishStatus @default(DRAFT)
  featuredOnHomepage   Boolean       @default(false)
  imageUrl             String?
  priceKobo            Int           @default(0)
  regularPriceKobo     Int?
  capacity             Int?
  /// Seats consumed. Maintained by an atomic conditional UPDATE rather than by
  /// counting enrolments, so simultaneous registrations cannot oversell:
  /// `SET seatsTaken = seatsTaken + 1 WHERE seatsTaken < capacity` either wins
  /// or affects zero rows. A CHECK constraint backs it up in the database.
  seatsTaken           Int           @default(0)
  startDate            DateTime?
  endDate              DateTime?
  registrationDeadline DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions    ProgramSession[]
  courses     ProgramCourse[]
  enrollments ProgramEnrollment[]
}

model ProgramSession {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  virtualLink String?

  @@index([programId])
}

model ProgramCourse {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locked    Boolean @default(true)
  order     Int     @default(0)

  @@unique([programId, courseId])
}

model ProgramEnrollment {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  status     String   @default("active")
  enrolledAt DateTime @default(now())

  @@unique([programId, childId])
  @@index([childId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

/// Billed to EITHER a parent (member billing) OR an organization (public quiz
/// product) — never both, never neither. A CHECK constraint in the migration
/// enforces that; see `invoice_payer_exactly_one`.
model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique // CEC-YYYY-NNNN
  parentId          String?
  parent            User?         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  childId           String?
  /// SetNull, not Cascade: a paid invoice is a financial record and must
  /// survive the child's profile being removed. It loses the link, never the
  /// row — deleting accounting history to tidy up a profile is not acceptable.
  child             Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  type              String        // program | course | subscription | custom | quiz_plan
  description       String
  amountKobo        Int
  status            InvoiceStatus @default(PENDING)
  paystackReference String?
  itemId            String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime      @default(now())

  payment Payment?

  @@index([parentId])
  @@index([organizationId])
  @@index([status])
  @@index([paystackReference])
}

/// Gapless counters, one row per sequence (e.g. "invoice:2026").
///
/// Deliberately NOT a Postgres sequence: nextval() does not roll back, so a
/// failed transaction burns a number and leaves a hole in the invoice run.
/// Accounting wants an unbroken series, so this row is locked FOR UPDATE inside
/// the same transaction that writes the invoice — the increment lives or dies
/// with it. The cost is that concurrent invoice creation serialises on this
/// row, which at our volume is irrelevant.
model Counter {
  key   String @id
  value Int    @default(0)
}

// Immutable ledger row — one per confirmed Paystack transaction.
model Payment {
  id            String   @id @default(cuid())
  invoiceId     String?  @unique
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  reference     String   @unique
  amountKobo    Int
  currency      String   @default("NGN")
  customerEmail String
  type          String
  status        String
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([customerEmail])
}

/// Held by EITHER a parent (member subscription) OR an organization (quiz plan)
/// — never both, never neither. Enforced by `subscription_holder_exactly_one`.
model Subscription {
  id                String        @id @default(cuid())
  parentId          String?
  parent            User?         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  childId           String?       // per-child scope (member subscriptions only)
  child             Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  planName          String
  scope             String        @default("per_child") // per_child | family | organization
  durationMonths    Int           @default(1)
  priceKobo         Int
  paystackReference String?
  status            String        @default("active")
  startDate         DateTime      @default(now())
  endDate           DateTime

  @@index([parentId])
  @@index([organizationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATIONS — the tenancy boundary for the paid public quiz product.
//
// CodeEarly itself is an Organization (the seeded SYSTEM org, id "codeearly"),
// so every quiz query is org-scoped uniformly and first-party content is never
// a special case with a null owner. Outside hosts — schools, event organisers,
// clubs, self-serve signups — get their own org and see only their own data.
// ─────────────────────────────────────────────────────────────────────────────

enum OrgType {
  SCHOOL
  EVENT
  CLUB
  OTHER
  SYSTEM // CodeEarly's own org — exempt from plan limits
}

enum OrgStatus {
  ACTIVE
  SUSPENDED // abuse / chargeback: blocks hosting, preserves data
}

enum OrgRole {
  OWNER
  ADMIN
  HOST // can run sessions, cannot manage billing or members
}

/// Plan catalogue for the public quiz product. Admin-editable so pricing and
/// limits change without a deploy. `key` is the stable identifier code uses.
model QuizPlan {
  id                   String  @id @default(cuid())
  key                  String  @unique // free | starter | pro | event_pass
  name                 String
  description          String?
  priceKobo            Int     @default(0)
  interval             String  @default("month") // month | year | one_time
  /// one_time plans (event passes) expire this many hours after purchase
  validityHours        Int?
  // ── Entitlements ──────────────────────────────────────────────────────────
  // Defaults mirror the free tier: a 5-player trial room. Every real-sized
  // room is a paid plan.
  maxPlayersPerSession Int     @default(5)
  maxQuestionsPerQuiz  Int     @default(10)
  maxSessionsPerMonth  Int?    // null = unlimited
  allowPdfExport       Boolean @default(false)
  allowCustomBranding  Boolean @default(false)
  allowGuestPlayers    Boolean @default(true)
  sortOrder            Int     @default(0)
  active               Boolean @default(true)

  organizations Organization[]
}

model Organization {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  type     OrgType   @default(OTHER)
  status   OrgStatus @default(ACTIVE)
  /// Null only for the seeded SYSTEM org (CodeEarly owns itself — no user row
  /// should be able to delete the platform's own tenant). Enforced by the
  /// `org_owner_required_unless_system` CHECK constraint.
  ownerId  String?
  owner    User?     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactEmail String?

  // Branding (gated by the allowCustomBranding entitlement)
  logoUrl    String?
  brandColor String?

  // ── Plan + entitlement snapshot ───────────────────────────────────────────
  // Limits are COPIED from QuizPlan at purchase time, not read through the
  // relation. A later price/limit change must never retroactively shrink a
  // room someone already paid for or break a scheduled event mid-flight.
  planKey              String    @default("free")
  plan                 QuizPlan  @relation(fields: [planKey], references: [key])
  planStartedAt        DateTime  @default(now())
  planExpiresAt        DateTime? // null = perpetual (free tier)
  maxPlayersPerSession Int       @default(5)
  maxQuestionsPerQuiz  Int       @default(10)
  maxSessionsPerMonth  Int?
  allowPdfExport       Boolean   @default(false)
  allowCustomBranding  Boolean   @default(false)

  // ── Trust & safety ────────────────────────────────────────────────────────
  // Public rooms put strangers near children, so hosting is gated on a verified
  // owner and every suspension keeps its reason for audit.
  verifiedAt        DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrgMember[]
  competitions  Competition[]
  invoices      Invoice[]
  subscriptions Subscription[]

  @@index([ownerId])
  @@index([status])
  @@index([planKey])
}

model OrgMember {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     OrgRole      @default(HOST)
  joinedAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUIZ ENGINE (server-authoritative; phase is a DB-enforced enum)
// ─────────────────────────────────────────────────────────────────────────────

enum QuizPhase {
  LOBBY
  ACTIVE
  REVEALED
  ENDED
}

enum QuizVisibility {
  MEMBERS  // CodeEarly members only — child account required to play
  UNLISTED // anyone holding the join code may play as a guest
  PUBLIC   // additionally listed in the public quiz directory
}

model Competition {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String         @default("quiz") // quiz | project | general
  status         String         @default("upcoming")
  visibility     QuizVisibility @default(MEMBERS)
  createdAt      DateTime       @default(now())

  questions QuizQuestion[]
  sessions  QuizSession[]

  @@index([organizationId])
  @@index([visibility])
}

model QuizQuestion {
  id               String      @id @default(cuid())
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  text             String
  options          String[]
  correctAnswer    String
  timeLimitSeconds Int         @default(30)
  order            Int         @default(0)

  answers QuizAnswer[]

  @@index([competitionId])
}

model QuizSession {
  id                       String      @id @default(cuid())
  competitionId            String
  competition              Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phase                    QuizPhase   @default(LOBBY)
  currentQuestionIndex     Int         @default(-1)
  currentQuestionStartedAt DateTime?
  startedAt                DateTime    @default(now())
  endedAt                  DateTime?

  /// Room PIN for guest players. Released (set to null) when the session ends
  /// so codes can be reused; the code that was used is kept on QuizResult.
  joinCode            String? @unique
  /// Host must admit each joiner — the safety default for public rooms.
  requireHostApproval Boolean @default(false)
  /// Snapshot of the org's player cap at session creation, so a plan change
  /// mid-event cannot shrink a room that is already running.
  maxPlayers          Int     @default(5)
  /// Which user is running this session (org host or CodeEarly admin).
  hostUserId          String?

  participants QuizParticipant[]
  answers      QuizAnswer[]
  result       QuizResult?

  @@index([competitionId])
  @@index([phase])
}

/// A player in a session. Either a CodeEarly member (`childId` set) OR an
/// anonymous guest (`childId` null, identified by `guestToken`). Public rooms
/// cannot require every player to hold an account, so guest play is first-class
/// rather than a special case bolted on later.
model QuizParticipant {
  id          String      @id @default(cuid())
  sessionId   String
  session     QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  childId     String?
  child       Child?      @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Opaque token stored client-side so a guest can rejoin their own seat after
  /// a disconnect without impersonating anyone else.
  guestToken  String?
  /// Shown on the leaderboard. Member name, or a guest's chosen name after
  /// profanity/PII filtering.
  displayName String
  approved    Boolean     @default(true) // false while awaiting host admission
  totalScore  Int         @default(0)
  rank        Int?
  joinedAt    DateTime    @default(now())

  answers QuizAnswer[]

  // NULLs compare distinct in Postgres, so many guests coexist while a member
  // still cannot join the same session twice.
  @@unique([sessionId, childId])
  @@unique([sessionId, guestToken])
  @@index([sessionId])
}

model QuizAnswer {
  id             String          @id @default(cuid())
  sessionId      String
  session        QuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId  String
  participant    QuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer String
  correct        Boolean
  pointsEarned   Int
  answeredAt     DateTime        @default(now())

  @@unique([sessionId, participantId, questionId])
  @@index([sessionId])
}

// Immutable snapshot of a finished session — the source of truth for results/PDFs.
model QuizResult {
  id               String      @id @default(cuid())
  sessionId        String      @unique
  session          QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  competitionId    String
  competitionTitle String
  /// Denormalised snapshot — which org ran this. No FK: this table is an audit
  /// record, and it already dies with the org via Competition → Session cascade.
  organizationId   String
  /// The room PIN this session used, kept for support/audit after the live
  /// code is released back to the pool.
  joinCode         String?
  leaderboard      Json        // [{ rank, name, score }]
  participants     Json        // full per-participant answers
  endedAt          DateTime    @default(now())

  @@index([competitionId])
  @@index([organizationId])
}
